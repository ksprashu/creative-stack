{
  "$comment": [
    "Brand tokens consumed by every rendering skill (/shot, /deck, /vector,",
    "/raster, /render3d). Scaffold only — replace the placeholder values with",
    "the real Google/GCP brand values from your internal brand portal.",
    "",
    "Override per-machine or per-project with brand/tokens.local.json, which is",
    "gitignored and deep-merged over this file. Pass --brand <name> to any skill",
    "to select a profile."
  ],

  "default": "google",

  "profiles": {
    "google": {
      "label": "Google / GCP",
      "color": {
        "brand": {
          "blue": "#4285F4",
          "red": "#EA4335",
          "yellow": "#FBBC04",
          "green": "#34A853"
        },
        "light": {
          "bg": "#FFFFFF",
          "surface": "#F8F9FA",
          "surfaceAlt": "#E8EAED",
          "border": "#DADCE0",
          "text": "#202124",
          "textMuted": "#5F6368",
          "accent": "#1A73E8"
        },
        "dark": {
          "bg": "#202124",
          "surface": "#292A2D",
          "surfaceAlt": "#35363A",
          "border": "#3C4043",
          "text": "#E8EAED",
          "textMuted": "#9AA0A6",
          "accent": "#8AB4F8"
        },
        "$todo": "Confirm these against the current GCP brand spec before publishing."
      },

      "font": {
        "display": "Google Sans Display, Google Sans, Roboto, Inter, sans-serif",
        "body": "Roboto, Inter, -apple-system, sans-serif",
        "mono": "Google Sans Code, Roboto Mono, JetBrains Mono, monospace",
        "$note": "Google Sans is not redistributable. Brewfile installs Google Sans Code (which is open) plus Roboto and Inter as fallbacks."
      },

      "type": {
        "scale": [12, 14, 16, 20, 24, 32, 40, 56, 72],
        "lineHeight": 1.5,
        "tightLineHeight": 1.15
      },

      "space": { "unit": 8, "scale": [4, 8, 16, 24, 32, 48, 64, 96] },

      "radius": { "sm": 4, "md": 8, "lg": 16, "xl": 28, "full": 9999 },

      "shadow": {
        "sm": "0 1px 2px rgba(60,64,67,.30), 0 1px 3px 1px rgba(60,64,67,.15)",
        "md": "0 1px 3px rgba(60,64,67,.30), 0 4px 8px 3px rgba(60,64,67,.15)",
        "lg": "0 2px 6px rgba(60,64,67,.30), 0 8px 24px 4px rgba(60,64,67,.15)",
        "hero": "0 24px 70px rgba(0,0,0,.35)"
      },

      "gradient": {
        "hero": "linear-gradient(135deg, #4285F4 0%, #34A853 100%)",
        "warm": "linear-gradient(135deg, #EA4335 0%, #FBBC04 100%)",
        "subtle": "linear-gradient(160deg, #E8F0FE 0%, #F8F9FA 100%)",
        "dusk": "linear-gradient(160deg, #202124 0%, #1A73E8 140%)"
      },

      "logo": {
        "mark": "brand/assets/logo-mark.svg",
        "wordmark": "brand/assets/logo-wordmark.svg",
        "$todo": "Drop the real SVGs at these paths; skills degrade gracefully if absent."
      },

      "video": {
        "resolution": [1920, 1080],
        "fps": 30,
        "safeMargin": 64,
        "loudnessTarget": -14,
        "truePeak": -1.0,
        "captionFont": "Roboto",
        "captionSize": 42
      },

      "screenshot": {
        "backdropPadding": 96,
        "cornerRadius": 12,
        "defaultBackdrop": "subtle",
        "deviceFrame": "macos-window",
        "retinaScale": 2
      }
    },

    "personal": {
      "label": "Personal blog",
      "$extends": "google",
      "color": {
        "light": { "accent": "#7C3AED" },
        "dark": { "accent": "#A78BFA" }
      },
      "font": {
        "display": "Inter, sans-serif",
        "body": "Inter, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "gradient": {
        "hero": "linear-gradient(135deg, #7C3AED 0%, #2563EB 100%)"
      }
    }
  }
}
