          "debian": null,
          "check": "cargo --version 2>/dev/null | awk 'NR==1{split($2,v,\".\"); ok=(v[1]>1 || v[2]>=82)} END{exit !ok}'",
          "fallback": {
            "kind": "source",
            "name": "rustup"
